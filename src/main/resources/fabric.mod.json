{
	"schemaVersion": 1,
	"id": "chromaticaberration",
	"version": "${version}",
	"name": "Chromatic aberration",
	"description": "Renders a chromatic aberration effect in the player camera view. The effect scales with camera speed: the faster you move, the stronger the aberration.",
	"authors": [
		"mormkillen"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/chromaticaberration/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.mormkillen.chromaticaberration.ChromaticAberrationClient"
		],
		"modmenu": [
			"com.mormkillen.chromaticaberration.ModMenuIntegration"
		]
	},
	"mixins": [
		"chromaticaberration.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "${minecraft_dep}",
		"java": "${java_dep}",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": ">=7.0.0"
	}
}
